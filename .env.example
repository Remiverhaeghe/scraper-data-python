FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE=
FRANCE_TRAVAIL_TOKEN_URL=
FRANCE_TRAVAIL_API_BASE_URL=
# Identifiants d'entreprises, séparés par des virgules (ex. LEVER_SITE=qonto,spotify)
GREENHOUSE_BOARD=
LEVER_SITE=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
FINDWORK_API_KEY=
# Facultatif : taux de prélèvement à la source par défaut, en pourcentage (ex. 7.5) ; modifiable ensuite dans Paramètres
INCOME_TAX_RATE=
# Facultatif : notifications e-mail de la recherche planifiée, via un mot de passe d'application Gmail
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Tableau de bord web : identifiant, puis empreinte et secret générés par python -m web.password
WEB_USERNAME=
WEB_PASSWORD_HASH=
WEB_SESSION_SECRET=
# Facultatif : 1 lorsque le tableau de bord est servi en HTTPS
WEB_SECURE_COOKIE=
