# Configuration de JobBoard Perso
#
# Copier ce fichier en .env, puis compléter les valeurs utiles.
# Le fichier .env contient des secrets : il est ignoré par git et ne doit jamais être partagé.
# Une variable laissée vide désactive simplement la fonctionnalité correspondante,
# son état est visible dans la page Paramètres.


# ------------------------------------------------------------------
# Sources d'offres avec clé d'accès
# Chaque source demande un compte gratuit sur son site développeur.
# ------------------------------------------------------------------

# Adzuna : créer une application sur https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble : demander une clé sur https://jooble.org/api/about
JOOBLE_API_KEY=

# Findwork : clé disponible dans le profil sur https://findwork.dev/developers
FINDWORK_API_KEY=

# France Travail : créer une application sur https://francetravail.io
# Seuls l'identifiant et le secret sont personnels, les adresses sont publiques.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=%2Fpartenaire
# Adresse de base, terminée par une barre : le chemin des offres y est ajouté
FRANCE_TRAVAIL_API_BASE_URL=https://api.francetravail.io/partenaire/


# ------------------------------------------------------------------
# Sources d'offres d'entreprises précises
# Indiquer l'identifiant de chaque entreprise, séparés par des virgules.
# ------------------------------------------------------------------

# Greenhouse : identifiant visible dans l'adresse boards.greenhouse.io/<identifiant>
GREENHOUSE_BOARD=


# ------------------------------------------------------------------
# Calcul du salaire net
# ------------------------------------------------------------------

# Facultatif : taux de prélèvement à la source, en pourcentage (exemple : 7.5).
# Sert de valeur de départ, modifiable ensuite dans la page Paramètres.
INCOME_TAX_RATE=


# ------------------------------------------------------------------
# Notifications e-mail de la recherche planifiée
# Facultatif : sans ces valeurs, aucun e-mail n'est envoyé.
# ------------------------------------------------------------------

# Adresse Gmail qui envoie les e-mails
GMAIL_ADDRESS=

# Mot de passe d'application, et non le mot de passe habituel du compte :
# activer la validation en deux étapes, puis le créer sur
# https://myaccount.google.com/apppasswords (16 caractères, sans espaces)
GMAIL_APP_PASSWORD=


# ------------------------------------------------------------------
# Tableau de bord web (python -m web)
# Obligatoire pour s'y connecter : sans ces valeurs, il reste fermé.
# ------------------------------------------------------------------

# Identifiant de connexion, au choix
WEB_USERNAME=

# Lancer python -m web.password : la commande demande le mot de passe,
# puis affiche les deux lignes suivantes, à copier ici
WEB_PASSWORD_HASH=
WEB_SESSION_SECRET=

# Facultatif : 1 uniquement si le tableau de bord est servi en HTTPS
WEB_SECURE_COOKIE=

# Facultatif : adresse d'écoute, 127.0.0.1 par défaut (ce PC seulement).
# L'adresse Wi-Fi du PC, par exemple 192.168.1.80, ouvre le tableau de bord et
# l'API de l'application mobile aux appareils du réseau local.
WEB_HOST=


# ------------------------------------------------------------------
# Journaux (logs)
# ------------------------------------------------------------------

# Facultatif : nombre de jours de conservation des logs, 14 par défaut.
# Un fichier est créé chaque jour dans logs/, les plus anciens sont supprimés.
LOG_RETENTION_DAYS=

# Facultatif : dossier des logs, logs/ à la racine du projet par défaut.
# Les tests le remplacent par un dossier temporaire pour ne pas mêler leurs messages.
LOG_DIRECTORY=
