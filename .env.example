# Configuration de JobBoard Perso
#
# Copier ce fichier en .env, puis compléter les valeurs utiles.
# Le fichier .env contient des secrets : il est ignoré par git et ne doit jamais être partagé.
# Une variable laissée vide désactive simplement la fonctionnalité correspondante,
# son état est visible dans la page Paramètres.


# ------------------------------------------------------------------
# Sources d'offres avec clé d'accès
# Chaque source demande un compte gratuit sur son site développeur.
# ------------------------------------------------------------------

# Adzuna : créer une application sur https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble : demander une clé sur https://jooble.org/api/about
JOOBLE_API_KEY=

# Findwork : clé disponible dans le profil sur https://findwork.dev/developers
FINDWORK_API_KEY=

# France Travail : créer une application sur https://francetravail.io
# Seuls l'identifiant et le secret sont personnels, les adresses sont publiques.
# Accès à demander sur francetravail.io (application, API « Offres d'emploi v2 ») ;
# une fois accordé, renseigner les identifiants et mettre FRANCE_TRAVAIL_ACCESS_GRANTED=1.
FRANCE_TRAVAIL_ACCESS_GRANTED=
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=%2Fpartenaire
# Adresse de base, terminée par une barre : le chemin des offres y est ajouté
FRANCE_TRAVAIL_API_BASE_URL=https://api.francetravail.io/partenaire/


# ------------------------------------------------------------------
# Sources d'offres d'entreprises précises
# Indiquer l'identifiant de chaque entreprise, séparés par des virgules.
# ------------------------------------------------------------------

# Greenhouse : identifiant visible dans l'adresse boards.greenhouse.io/<identifiant>
GREENHOUSE_BOARD=

# SmartRecruiters : identifiant de jobs.smartrecruiters.com/<identifiant>. Vide :
# Alten, Assystem, Eurofins, Loxam, Trigo, Bosch, Saint-Gobain, Ubisoft, et Kiabi,
# Lesaffre et Boulanger, sièges dans la métropole lilloise.
SMARTRECRUITERS_COMPANIES=
# Pays des offres SmartRecruiters, code ISO (fr par défaut)
SMARTRECRUITERS_COUNTRY=

# Lever : identifiant de jobs.lever.co/<identifiant>. Vide : Qonto, Aircall,
# Swile, Agicap et Malt.
LEVER_COMPANIES=
# Ashby : identifiant de jobs.ashbyhq.com/<identifiant>. Vide : Alan,
# Pennylane, Ledger, Photoroom, Dust, lemlist et Nabla.
ASHBY_COMPANIES=
# Recruitee : identifiant de <identifiant>.recruitee.com (aucun par défaut)
RECRUITEE_COMPANIES=
# Workable : compte de apply.workable.com/<compte> (aucun par défaut)
WORKABLE_ACCOUNTS=
# Workday, grands groupes : [Nom=]hôte/tenant/site lu dans l'adresse du site
# carrière, https://valeo.wd3.myworkdayjobs.com/valeo_jobs donnant
# Valeo=valeo.wd3/valeo/valeo_jobs. Vide : Valeo, Airbus, LFB et Néosoft.
WORKDAY_SITES=
# Pays gardés pour Lever, Ashby, Recruitee et Workable, codes ISO séparés par
# des virgules (FR par défaut). Vide : tous les pays.
COMPANY_PAGES_COUNTRIES=FR


# ------------------------------------------------------------------
# Careerjet : clé d'éditeur gratuite, compte à créer sur
# careerjet.com/partners/register/as-publisher
# ------------------------------------------------------------------

CAREERJET_API_KEY=
# Adresse IP de ce poste, demandée par Careerjet (127.0.0.1 par défaut)
CAREERJET_USER_IP=
# Adresse du site déclaré à l'inscription, si Careerjet l'exige
CAREERJET_REFERER=


# ------------------------------------------------------------------
# La bonne alternance : offres en alternance, clé gratuite pour un usage
# non lucratif, sur api.apprentissage.beta.gouv.fr (« Obtenir une clé d'API »)
# ------------------------------------------------------------------

LBA_API_KEY=
# Codes métiers ROME cherchés, séparés par des virgules. Vide : maintenance
# industrielle, automatisme et informatique (I1304,I1310,H1208,M1805,M1810).
LBA_ROMES=


# ------------------------------------------------------------------
# Calcul du salaire net
# ------------------------------------------------------------------

# Facultatif : taux de prélèvement à la source, en pourcentage (exemple : 7.5).
# Sert de valeur de départ, modifiable ensuite dans la page Paramètres.
INCOME_TAX_RATE=


# ------------------------------------------------------------------
# Notifications e-mail de la recherche planifiée
# Facultatif : sans ces valeurs, aucun e-mail n'est envoyé.
# ------------------------------------------------------------------

# Adresse Gmail qui envoie les e-mails
GMAIL_ADDRESS=

# Mot de passe d'application, et non le mot de passe habituel du compte :
# activer la validation en deux étapes, puis le créer sur
# https://myaccount.google.com/apppasswords (16 caractères, sans espaces)
GMAIL_APP_PASSWORD=


# ------------------------------------------------------------------
# Tableau de bord web (python -m web)
# Obligatoire pour s'y connecter : sans ces valeurs, il reste fermé.
# ------------------------------------------------------------------

# Identifiant de connexion, au choix
WEB_USERNAME=

# Lancer python -m web.password : la commande demande le mot de passe,
# puis affiche les deux lignes suivantes, à copier ici
WEB_PASSWORD_HASH=
WEB_SESSION_SECRET=
# Double authentification, conseillée hors du réseau local : python -m web.totp
# crée le secret et son QR code pour Google Authenticator. Vide : désactivée.
WEB_TOTP_SECRET=

# Facultatif : 1 uniquement si le tableau de bord est servi en HTTPS
WEB_SECURE_COOKIE=

# Facultatif : adresse d'écoute, 127.0.0.1 par défaut (ce PC seulement).
# L'adresse Wi-Fi du PC, par exemple 192.168.1.80, ouvre le tableau de bord et
# l'API de l'application mobile aux appareils du réseau local.
WEB_HOST=

# Facultatif : copie quotidienne des sauvegardes sur un NAS, par un dossier
# partagé (\\NAS\sauvegardes\jobboard) ou un lecteur réseau (Z:\jobboard).
# Le compte Windows qui lance le planificateur doit pouvoir y écrire. Les 30
# dernières copies sont gardées ; un NAS éteint est rattrapé au passage suivant.
BACKUP_NAS_DIRECTORY=

# Facultatif : chiffrement des copies du NAS. Clé donnée par
# python -m tools.backup_key ; gardez-la aussi hors du PC et du NAS.
BACKUP_ENCRYPTION_KEY=

# Docker sur le NAS : adresse où publier le tableau de bord, par exemple l'adresse
# Tailscale 100.x.y.z. Vide : joignable depuis le NAS seulement.
WEB_PUBLISHED_ADDRESS=

# Facultatif : HTTPS. Les deux chemins sont donnés par python -m
# tools.local_certificate (réseau local) ou python -m tools.tailscale_certificate
# (accès hors du domicile) ; vides, le tableau de bord reste en HTTP.
WEB_TLS_CERTFILE=
WEB_TLS_KEYFILE=

# Facultatif : nom du serveur donné au téléphone et à l'agenda quand il diffère de
# WEB_HOST, par exemple serveur.xxx.ts.net avec Tailscale. Vide : WEB_HOST.
WEB_PUBLIC_HOST=


# ------------------------------------------------------------------
# Journaux (logs)
# ------------------------------------------------------------------

# Facultatif : nombre de jours de conservation des logs, 14 par défaut.
# Un fichier est créé chaque jour dans logs/, les plus anciens sont supprimés.
LOG_RETENTION_DAYS=

# Facultatif : dossier des données, hors du projet : base, sauvegardes, pièces
# jointes, modèles de traduction, certificats, journaux, exports et imports.
# Documents/JobBoard par défaut ; l'image Docker utilise /app/data.
JOBBOARD_DATA_DIR=

# Facultatif : dossier des logs, logs/ du dossier des données par défaut.
# Les tests le remplacent par un dossier temporaire pour ne pas mêler leurs messages.
LOG_DIRECTORY=
