/* Les variables préfixées par un dollar sont remplacées par les couleurs de gui/theme.py */

QWidget {
    font-family: "Segoe UI";
    font-size: 13px;
    color: $text;
}

QMainWindow,
QStackedWidget {
    background: $background;
}

QScrollArea,
QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QToolTip {
    background: $heading;
    color: $background;
    border: none;
    padding: 6px 8px;
}

/* Menu latéral */

QWidget#sidebar {
    background: $surface;
    border-right: 1px solid $border;
}

QLabel#logo {
    background: $primary;
    color: $on_primary;
    font-size: 18px;
    font-weight: 700;
    border-radius: 10px;
}

QLabel#brandName {
    color: $heading;
    font-size: 15px;
    font-weight: 700;
}

QLabel#brandTagline,
QLabel#sidebarStatus {
    color: $muted;
    font-size: 12px;
}

QFrame#separator {
    background: $border;
    max-height: 1px;
    border: none;
}

QListWidget#navigation {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#navigation::item {
    color: $text;
    font-weight: 600;
    padding: 11px 12px;
    margin: 2px 0;
    border-radius: 8px;
}

QListWidget#navigation::item:hover {
    background: $primary_light;
}

QListWidget#navigation::item:selected {
    background: $primary;
    color: $on_primary;
}

/* En-têtes et cartes */

QLabel#pageTitle {
    color: $heading;
    font-size: 26px;
    font-weight: 700;
}

QLabel#pageIcon {
    background: $primary_light;
    border-radius: 10px;
}

QLabel#pageSubtitle,
QLabel#cardSubtitle,
QLabel#statisticLabel {
    color: $muted;
}

QFrame#card,
QGroupBox {
    background: $surface;
    border: 1px solid $border;
    border-radius: 12px;
}

QLabel#cardTitle {
    color: $heading;
    font-size: 16px;
    font-weight: 700;
}

QGroupBox {
    font-weight: 700;
    color: $heading;
    margin-top: 12px;
    padding: 18px 14px 12px 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
}

QGroupBox QLabel,
QGroupBox QCheckBox {
    font-weight: normal;
    color: $text;
}

QLabel#statisticValue {
    font-size: 28px;
    font-weight: 700;
}

QLabel#offerTitle {
    color: $heading;
    font-size: 18px;
    font-weight: 700;
}

QLabel#activityTitle {
    color: $heading;
    font-weight: 600;
}

QLabel#activityResult {
    color: $primary;
    font-weight: 600;
}

QLabel#fieldLabel {
    color: $muted;
    font-size: 12px;
    font-weight: 600;
}

QTextBrowser#descriptionText {
    border: none;
    background: transparent;
    padding: 0;
    font-size: 13px;
}

QLabel#warning {
    color: $warning;
}

/* Bannière d'accueil */

QFrame#banner {
    border-radius: 14px;
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 $primary, stop: 1 $primary_gradient);
}

QLabel#bannerTitle {
    color: $on_primary;
    font-size: 24px;
    font-weight: 700;
}

QLabel#bannerText {
    color: $banner_text;
    font-size: 14px;
}

/* Boutons */

QPushButton {
    background: $surface;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background: $primary_light;
    border-color: $primary;
}

QPushButton:disabled {
    color: $muted;
    background: $surface_alt;
}

QPushButton#primaryButton {
    background: $primary;
    color: $on_primary;
    border: none;
}

QPushButton#primaryButton:hover {
    background: $primary_dark;
}

QPushButton#primaryButton:disabled {
    background: $border;
}

QPushButton#bannerButton {
    background: $surface;
    color: $primary;
    border: none;
    padding: 10px 18px;
}

QPushButton#bannerButton:hover {
    background: $primary_light;
}

QPushButton#segmentButton:checked {
    background: $primary_light;
    border-color: $primary;
    color: $primary;
}

QPushButton#sourceChip {
    border-radius: 16px;
    padding: 7px 12px;
    text-align: left;
}

QPushButton#sourceChip:checked {
    background: $primary_light;
    border-color: $primary;
    color: $primary;
}

QPushButton#sourceChip:disabled {
    background: $surface_alt;
    border-style: dashed;
    color: $muted;
}

QPushButton#quickAction {
    text-align: left;
    padding: 12px 14px;
}

QPushButton#linkButton {
    border: none;
    background: transparent;
    color: $primary;
    text-align: left;
    padding: 0;
}

/* Champs de saisie */

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QPlainTextEdit,
QTextBrowser {
    background: $surface;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: $primary;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QPlainTextEdit:focus {
    border-color: $primary;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow,
QDateEdit::down-arrow {
    image: url($chevron_down);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background: $surface;
    border: 1px solid $border;
    selection-background-color: $primary_light;
    selection-color: $heading;
    outline: none;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    border: none;
    width: 22px;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url($chevron_up);
    width: 12px;
    height: 12px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url($chevron_down);
    width: 12px;
    height: 12px;
}

/* Tableaux */

QTableView {
    background: $surface;
    alternate-background-color: $surface_alt;
    border: 1px solid $border;
    border-radius: 10px;
    gridline-color: transparent;
    selection-background-color: $primary_light;
    selection-color: $heading;
}

QTableView::item {
    padding: 6px 8px;
    border-bottom: 1px solid $border;
}

QHeaderView::section {
    background: $surface;
    color: $muted;
    border: none;
    border-bottom: 1px solid $border;
    padding: 9px 8px;
    font-weight: 600;
}

/* Progression */

QProgressBar {
    background: $primary_light;
    border: none;
    border-radius: 7px;
    min-height: 14px;
    max-height: 14px;
    text-align: center;
    font-size: 11px;
    color: $heading;
}

QProgressBar::chunk {
    background: $primary;
    border-radius: 7px;
}

QSplitter::handle {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: $border;
    border-radius: 3px;
    min-height: 30px;
    min-width: 30px;
}

QScrollBar::handle:hover {
    background: $muted;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    width: 0;
    height: 0;
}
