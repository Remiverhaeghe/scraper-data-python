/* Les couleurs viennent de la palette Qt pour suivre le thème clair ou sombre */

QWidget#sidebar {
    background: palette(base);
    border-right: 1px solid palette(mid);
}

QLabel#brand {
    font-size: 16px;
    font-weight: 600;
    padding: 0 8px 16px 8px;
}

QListWidget#navigation {
    background: transparent;
    border: none;
    font-size: 14px;
    outline: none;
}

QListWidget#navigation::item {
    padding: 10px 12px;
    border-radius: 6px;
}

QListWidget#navigation::item:selected {
    background: palette(highlight);
    color: palette(highlighted-text);
}

QLabel#pageTitle {
    font-size: 24px;
    font-weight: 600;
}

QLabel#pageSubtitle,
QLabel#statisticLabel {
    color: palette(placeholder-text);
}

QFrame#statisticCard {
    background: palette(base);
    border: 1px solid palette(mid);
    border-radius: 8px;
}

QLabel#statisticValue {
    font-size: 28px;
    font-weight: 600;
    color: palette(highlight);
}

QGroupBox {
    font-weight: 600;
    border: 1px solid palette(mid);
    border-radius: 8px;
    margin-top: 10px;
    padding: 14px 12px 10px 12px;
    background: palette(base);
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}

QGroupBox QLabel,
QGroupBox QCheckBox {
    font-weight: normal;
}

QPushButton {
    padding: 6px 14px;
}

QPushButton#primaryButton {
    background: palette(highlight);
    color: palette(highlighted-text);
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
    font-weight: 600;
}

QPushButton#primaryButton:disabled {
    background: palette(mid);
}

QPushButton#linkButton {
    border: none;
    background: transparent;
    color: palette(link);
    text-align: left;
    padding: 0;
}

QLabel#warning {
    color: #d97706;
}
